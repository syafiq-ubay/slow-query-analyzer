# Elasticsearch / Kibana connection
ELASTIC_URL=https://elastic.example.com
ELASTIC_USER=
ELASTIC_PASS=
MYSQL_DATA_VIEW_ID=44d4edd4-7529-40a5-ac59-616e7d5bfd6f
NGINX_DATA_VIEW_ID=a4bd8dac-e16e-4d4f-a48a-852860ae99ad

# Timestamp range. START_TIME=auto uses the earliest timestamp found in CSV/XLSX
# files under INPUT_DIR. If none are found, it uses the start of today's date.
START_TIME=auto
END_TIME=now
INPUT_DIR=input

# Optional Elasticsearch query_string filters (KQL-like field expressions).
# Examples: MYSQL_FILTER='schema: shop' and NGINX_FILTER='code: 500' or 'query_time:>=5'
MYSQL_FILTER=
NGINX_FILTER=

# Optional Nginx HTTP status codes to exclude by default in nginx and merge modes.
# Leave empty to exclude no status codes. Separate multiple codes with commas.
NGINX_EXCLUDE_CODES=

